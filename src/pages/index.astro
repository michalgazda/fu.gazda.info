---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Andrzej Gazda — Wykończanie i Remonty Wnętrz | Dębica">
  <section class="hero">
    <div class="wrap hero-content">
      <h1>Remonty i wykończenia<br />na najwyższym poziomie</h1>
      <p class="subtitle">
        Firma Wykończeniowa Andrzej Gazda — zaufany fach w rejonie Dębicy i okolic (województwo podkarpackie).
        Wykonujemy kompleksowe wykończenia i remonty domów, mieszkań, biur i sklepów.
      </p>
      <div class="hero-badges">
        <span class="hero-badge">✓ Ponad 10 lat doświadczenia</span>
        <span class="hero-badge">✓ Sufity podwieszane</span>
        <span class="hero-badge">✓ Wykończenia wnętrz</span>
        <span class="hero-badge">✓ Stiuk i glinka wenecka</span>
      </div>
      <a class="hero-btn" href="/zakres-uslug/">Zobacz zakres usług</a>
      <a class="hero-btn-outline" href="/galeria/">Nasze realizacje</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-title">
        <h2>Co wykonujemy</h2>
      </div>
      <div class="services-grid">
        <div class="service-card">
          <span class="service-icon">🏠</span>
          <h3>Remonty i wykończenia</h3>
          <p>Kompleksowe remonty domów, mieszkań, biur i sklepów z dbałością o każdy detal.</p>
        </div>
        <div class="service-card">
          <span class="service-icon">⬇️</span>
          <h3>Sufity podwieszane</h3>
          <p>Montaż sufitów podwieszanych i konstrukcji z płyt gipsowo-kartonowych.</p>
        </div>
        <div class="service-card">
          <span class="service-icon">🎨</span>
          <h3>Malowanie i tynki dekoracyjne</h3>
          <p>Gipsowanie i malowanie ścian, stiuki, trawertyny, glinka wenecka, telstar i inne efekty.</p>
        </div>
        <div class="service-card">
          <span class="service-icon">🪵</span>
          <h3>Podłogi i parkiety</h3>
          <p>Układanie, cyklinowanie i polerowanie parkietu, montaż podłóg, schodów i tralek.</p>
        </div>
        <div class="service-card">
          <span class="service-icon">🧱</span>
          <h3>Płytki i boazeria</h3>
          <p>Montaż boazerii oraz okładziny ścienne z płytek i materiałów dekoracyjnych.</p>
        </div>
        <div class="service-card">
          <span class="service-icon">🤝</span>
          <h3>Wystawiamy rachunki VAT</h3>
          <p>Pełna obsługa formalna i faktury VAT dla firm oraz osób prywatnych.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="wrap">
      <div class="section-title">
        <h2>Dlaczego my</h2>
      </div>
      <div class="stats-grid">
        <div>
          <div class="stat-number">100%</div>
          <div class="stat-label">Fachowe wykonanie</div>
        </div>
        <div>
          <div class="stat-number">14 676 28 40</div>
          <div class="stat-label">Kontakt telefoniczny</div>
        </div>
        <div>
          <div class="stat-number">Dębica</div>
          <div class="stat-label">i okolice</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
