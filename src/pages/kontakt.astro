---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Kontakt — Andrzej Gazda Wykończanie i Remonty Wnętrz" description="Skontaktuj się z firmą wykończeniową Andrzeja Gazdy. Telefon: 14 676 28 40. Obsługujemy Dębicę i okolice (województwo podkarpackie).">
  <section class="page-header">
    <div class="wrap">
      <h1>Kontakt</h1>
      <p style="color: rgba(255,255,255,0.8);">Skontaktuj się z nami</p>
    </div>
  </section>

  <section class="page-content">
    <div class="wrap contact-grid">
      <div class="contact-card">
        <h3>Dane kontaktowe</h3>
        <div class="contact-row">
          <span class="contact-icon">📞</span>
          <div>
            <strong>Telefon:</strong><br />
            <a href="tel:+48146762840">14 676 28 40</a>
          </div>
        </div>
        <div class="contact-row">
          <span class="contact-icon">📍</span>
          <div>
            <strong>Region działania:</strong><br />
            Dębica i okolice (województwo podkarpackie)
          </div>
        </div>
        <div class="contact-row">
          <span class="contact-icon">🕐</span>
          <div>
            <strong>Umów termin</strong><br />
            Zadzwoń, a pomożemy dobrać dogodny termin realizacji.
          </div>
        </div>
        <a class="hero-btn" href="tel:+48146762840" style="display:inline-block;">📞 Zadzwoń: 14 676 28 40</a>
      </div>
      <div>
        <div class="contact-card">
          <h3>Firma Usługowa</h3>
          <p>
            <strong>Wykończanie i Remonty Wnętrz<br />Andrzej Gazda</strong>
          </p>
          <p style="color: var(--ink-soft);">
            Oferujemy fachowe wykonanie prac remontowych i wykończeniowych
            w najwyższej jakości. Wystawiamy rachunki VAT.
          </p>
          <p style="margin-bottom:0;">
            Serdecznie zapraszamy do kontaktu — <a href={base + 'galeria/'}>zobacz nasze realizacje</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
