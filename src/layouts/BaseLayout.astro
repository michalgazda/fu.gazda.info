---
const links = [
  { href: '/', label: 'Strona główna' },
  { href: '/zakres-uslug/', label: 'Zakres usług' },
  { href: '/galeria/', label: 'Galeria' },
  { href: '/o-firmie/', label: 'O firmie' },
  { href: '/kontakt/', label: 'Kontakt' },
];
const { title = 'Firma Wykończeniowa Andrzej Gazda',
        description = 'Firma Usługowa Wykańczanie i Remonty Wnętrz Andrzej Gazda — remonty i wykończenia mieszkań, domów i biur w rejonie Dębicy i okolic.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const origin = Astro.site.origin;
---
<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>%F0%9F%9B%A7%EF%B8%8F</text></svg>" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Andrzej Gazda — Wykończanie i Remonty Wnętrz" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="pl_PL" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
    "name": "Andrzej Gazda — Wykończanie i Remonty Wnętrz",
    "description": description,
    "url": origin + base,
    "telephone": "+48146762840",
    "areaServed": "Dębica i okolice",
    "address": { "@type": "PostalAddress", "addressLocality": "Dębica", "addressRegion": "podkarpackie", "addressCountry": "PL" },
    "priceRange": "$$",
    "image": origin + base + "images/gallery/sufit_podwieszany2.jpg"
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={`${import.meta.env.BASE_URL}global.css`} />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={base}>
        <span class="brand-mark">AG</span>
        <span class="brand-text">
          <strong>Andrzej Gazda</strong>
          <small>Wykończanie i remonty wnętrz</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="Nawigacja główna">
        {
          links.map((l) => (
            <a href={base + l.href.slice(1)} class:list={['nav-link', { active: Astro.url.pathname === l.href }]}>{l.label}</a>
          ))
        }
      </nav>
      <a class="nav-cta" href="tel:+48146762840">14 676 28 40</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <h4>Andrzej Gazda</h4>
        <p>Firma Usługowa<br />Wykańczanie i Remonty Wnętrz</p>
      </div>
      <div>
        <h4>Nawigacja</h4>
        <ul>
          <li><a href={base + 'zakres-uslug/'}>Zakres usług</a></li>
          <li><a href={base + 'galeria/'}>Galeria</a></li>
          <li><a href={base + 'o-firmie/'}>O firmie</a></li>
          <li><a href={base + 'kontakt/'}>Kontakt</a></li>
        </ul>
      </div>
      <div>
        <h4>Kontakt</h4>
        <p>Telefon: <a href="tel:+48146762840">14 676 28 40</a><br />Region: Dębica i okolice</p>
      </div>
    </div>
    <div class="wrap footer-bottom">
      <p>© {new Date().getFullYear()} Andrzej Gazda — Wykończanie i remonty wnętrz. Wszelkie prawa zastrzeżone.</p>
    </div>
  </footer>
</body>
</html>

